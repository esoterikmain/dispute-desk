# Everything here is optional. With nothing set, Dispute Desk runs against a built-in
# PayPal simulator with a deterministic rules engine, so it works straight after `npm install`.

# Claude does the dispute analysis and the natural-language grid filter.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Daily ceilings on paid model calls (reset at midnight UTC). When one is reached the app
# falls back to the rules engine / keyword filter and says so. 0 = unlimited.
# AI_DAILY_ANALYSES=100
# AI_DAILY_FILTERS=300

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered for CUSTOMER.DISPUTE.* events. When set, signatures are verified.
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sample cases (the built-in simulator) stay available next to real PayPal so visitors can
# try the product without a PayPal login. Set to off to show real cases only.
# DEMO_DATA=off

# Postgres connection string. Unset = embedded PGlite database in ./.data
DATABASE_URL=
